<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Apertus Invoice Assistant â€” Swiss AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/chat.css">
<style>
  .upload-btn {
    background: transparent;
    border: 1px solid #e30613;
    color: #e30613;
    border-radius: 6px;
    padding: 0 14px;
    height: 44px;
    cursor: pointer;
    font-size: 20px;
    transition: all 0.2s ease;
    margin-right: 8px;
  }
  .upload-btn:hover {
    background: #e30613;
    color: #fff;
  }
  .upload-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .file-preview {
    display: none;
    background: #1a1a1a;
    border: 1px solid #333;
    border-radius: 6px;
    padding: 8px 12px;
    margin: 8px 0;
    font-size: 13px;
    color: #ccc;
    align-items: center;
    justify-content: space-between;
  }
  .file-preview.visible {
    display: flex;
  }
  .file-preview .file-info {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .file-preview .remove-file {
    background: transparent;
    border: none;
    color: #e30613;
    cursor: pointer;
    font-size: 16px;
    padding: 0 6px;
  }
</style>
</head>
<body>

  <canvas id="circuits-canvas" class="circuits-canvas"></canvas>
  <canvas id="neural-canvas" class="neural-canvas"></canvas>
  <canvas id="fire-canvas" class="fire-canvas"></canvas>
  <div class="bg-layer bg-grid"></div>
  <div class="bg-layer bg-scanlines"></div>
  <div class="bg-layer bg-glow"></div>
  <div class="bg-layer bg-vignette"></div>

  <div class="intro" id="intro">
    <div class="intro-cross-wrap">
      <canvas id="intro-fire-canvas" class="intro-fire-canvas"></canvas>
      <div class="intro-cross">
        <div class="cross-h"></div>
        <div class="cross-v"></div>
      </div>
      <div class="intro-cross-glow"></div>
    </div>
    <div class="intro-logo" data-text="APERTUS">APERTUS</div>
    <div class="intro-subtitle">SWISS SOVEREIGN LLM Â· INITIALIZING</div>
    <div class="intro-progress">
      <div class="intro-progress-bar"></div>
    </div>
  </div>

  <div class="app" id="app">
    <header>
      <div class="logo-wrap">
        <canvas id="header-fire-canvas" class="header-fire-canvas"></canvas>
        <div class="swiss-cross-small">
          <div class="cross-h-small"></div>
          <div class="cross-v-small"></div>
        </div>
      </div>

      <div class="title-block">
        <h1 class="glitch-title" data-text="APERTUS">
          APERTUS <span class="label">INVOICE ASSISTANT</span>
        </h1>
        <p>
          <span class="status-dot"></span>
          POWERED BY SWISS AI
          <span class="sep">Â·</span>
          <span class="author">by Anio Joseph</span>
        </p>
      </div>

      <button id="theme-toggle" class="theme-toggle" title="Cycle theme: Dark / Light / Blue Flame">
        <span class="theme-icon">ðŸŒ™</span>
      </button>

      <div class="hud">
        <div class="hud-line"></div>
        <div class="hud-text">SWISS SOVEREIGN LLM</div>
        <div class="hud-metrics">
          <span class="metric"><span class="metric-label">MODEL</span> <span class="metric-value">8B</span></span>
          <span class="metric"><span class="metric-label">CTX</span> <span class="metric-value">65K</span></span>
          <span class="metric"><span class="metric-label">LAT</span> <span class="metric-value" id="latency">--</span></span>
        </div>
      </div>
    </header>

    <div class="chat" id="chat">
      <div class="message agent">
        <div class="avatar">AI</div>
        <div class="bubble">
          <div class="bubble-title">SYSTEM READY</div>
          I am your invoice reconciliation assistant, powered by <strong>Apertus</strong> â€” Switzerland's sovereign LLM.<br><br>
          Try saying: <em>"Reconcile invoice INV-2026-0042"</em>
        </div>
      </div>
    </div>

    <div class="composer">
      <div class="input-wrap">
        <span class="input-prompt">&gt;</span>
        <div class="file-preview" id="file-preview">
      <div class="file-info">
        <span>📎</span>
        <span id="file-name">document.pdf</span>
        <span id="file-size">(0 KB)</span>
      </div>
      <button class="remove-file" id="remove-file" title="Remove file">✕</button>
    </div>
    <button class="upload-btn" id="upload-btn" title="Upload a document (JPEG, PNG, PDF)">📎</button>
    <input type="text" id="input" placeholder="Type your request..." autocomplete="off" />
      </div>
      <button id="send">
        SEND <span class="arrow">-></span>
      </button>
    </div>

    <div class="corner corner-tl"></div>
    <div class="corner corner-tr"></div>
    <div class="corner corner-bl"></div>
    <div class="corner corner-br"></div>
  </div>

  <script src="/static/js/chat.js"></script>
<input type="file" id="file-input" accept=".jpg,.jpeg,.png,.tif,.tiff,.bmp,.webp,.pdf" style="display:none;">
</body>
</html>
