<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Apertus Dashboard - Swiss AI</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background: #0a0e27;
      color: #e0e6ff;
      min-height: 100vh;
      padding: 32px;
    }
    .container { max-width: 1400px; margin: 0 auto; }

    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 32px;
      padding-bottom: 20px;
      border-bottom: 2px solid #e30613;
    }
    .header h1 {
      font-size: 28px;
      font-weight: 800;
      color: #e30613;
      letter-spacing: 2px;
    }
    .header .subtitle {
      color: #8892b0;
      font-size: 13px;
      margin-top: 4px;
    }
    .header a {
      color: #00d4ff;
      text-decoration: none;
      font-size: 14px;
      padding: 8px 16px;
      border: 1px solid #00d4ff;
      border-radius: 6px;
      transition: all 0.2s;
    }
    .header a:hover {
      background: #00d4ff;
      color: #0a0e27;
    }

    .kpis {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }
    .kpi {
      background: #131a3a;
      border: 1px solid #1e2a52;
      border-radius: 12px;
      padding: 20px;
      transition: all 0.3s;
    }
    .kpi:hover {
      border-color: #00d4ff;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 212, 255, 0.15);
    }
    .kpi .label {
      font-size: 11px;
      color: #8892b0;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 8px;
    }
    .kpi .value {
      font-family: 'JetBrains Mono', monospace;
      font-size: 32px;
      font-weight: 800;
      color: #fff;
    }
    .kpi.red .value { color: #e30613; }
    .kpi.green .value { color: #22c55e; }
    .kpi.orange .value { color: #f59e0b; }
    .kpi.blue .value { color: #00d4ff; }

    .charts {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 16px;
      margin-bottom: 32px;
    }
    .card {
      background: #131a3a;
      border: 1px solid #1e2a52;
      border-radius: 12px;
      padding: 24px;
    }
    .card h2 {
      font-size: 14px;
      color: #8892b0;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 16px;
    }
    .chart-wrap { position: relative; height: 280px; }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    table th {
      text-align: left;
      padding: 10px 12px;
      color: #8892b0;
      font-weight: 600;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 1px;
      border-bottom: 1px solid #1e2a52;
    }
    table td {
      padding: 12px;
      border-bottom: 1px solid #1a2240;
      color: #c9d1e8;
    }
    table tr:hover td { background: #1a2240; }

    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge.low { background: rgba(34, 197, 94, 0.2); color: #22c55e; }
    .badge.medium { background: rgba(245, 158, 11, 0.2); color: #f59e0b; }
    .badge.high { background: rgba(249, 115, 22, 0.2); color: #f97316; }
    .badge.critical { background: rgba(220, 38, 38, 0.2); color: #ef4444; }
    .badge.unknown { background: rgba(136, 146, 176, 0.2); color: #8892b0; }

    /* === BOUTON CORBEILLE === */
    .trash-btn {
      background: transparent;
      border: 1px solid #e30613;
      color: #e30613;
      width: 30px;
      height: 30px;
      border-radius: 6px;
      cursor: pointer;
      font-size: 14px;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .trash-btn:hover {
      background: #e30613;
      color: #fff;
    }

    .refresh-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      color: #8892b0;
      margin-bottom: 16px;
    }
    .refresh-bar .dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      background: #22c55e;
      border-radius: 50%;
      margin-right: 6px;
      animation: pulse 2s infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.3; }
    }

    @media (max-width: 900px) {
      .charts { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div>
        <h1>APERTUS DASHBOARD</h1>
        <div class="subtitle">Autonomous Invoice Reconciliation & Fraud Detection - Hack Apertus 2026</div>
      </div>
      <a href="/chat">Back to Chat</a>
    </div>

    <div class="refresh-bar">
      <div><span class="dot"></span>Live update every 10 seconds</div>
      <div id="last-update">Last update: --</div>
    </div>

    <div class="kpis">
      <div class="kpi blue">
        <div class="label">Documents Analyzed</div>
        <div class="value" id="kpi-docs">0</div>
      </div>
      <div class="kpi red">
        <div class="label">Alerts (Medium+)</div>
        <div class="value" id="kpi-alerts">0</div>
      </div>
      <div class="kpi orange">
        <div class="label">Total Amount</div>
        <div class="value" id="kpi-amount">0</div>
      </div>
      <div class="kpi green">
        <div class="label">Critical Cases</div>
        <div class="value" id="kpi-critical">0</div>
      </div>
    </div>

    <div class="charts">
      <div class="card">
        <h2>Risk Scores Over Time</h2>
        <div class="chart-wrap"><canvas id="scoresChart"></canvas></div>
      </div>
      <div class="card">
        <h2>Risk Level Distribution</h2>
        <div class="chart-wrap"><canvas id="levelsChart"></canvas></div>
      </div>
    </div>

    <div class="card" style="margin-bottom: 32px;">
      <h2>Top Suppliers</h2>
      <table>
        <thead>
          <tr><th>Supplier</th><th>Documents</th><th>Total Amount</th></tr>
        </thead>
        <tbody id="suppliers-body">
          <tr><td colspan="3" style="text-align:center;color:#8892b0;">No data yet</td></tr>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>Recent Analyses</h2>
      <table>
        <thead>
          <tr>
            <th>Date</th>
            <th>Reference</th>
            <th>Supplier</th>
            <th>Amount</th>
            <th>Risk</th>
            <th>Decision</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody id="recent-body">
          <tr><td colspan="7" style="text-align:center;color:#8892b0;">No analyses yet</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <script>
    let scoresChart = null;
    let levelsChart = null;

    async function loadStats() {
      try {
        const res = await fetch('/api/stats');
        const data = await res.json();

        document.getElementById('kpi-docs').textContent = data.total_docs;
        document.getElementById('kpi-alerts').textContent = data.alerts;
        document.getElementById('kpi-amount').textContent = data.total_amount.toLocaleString('en-US', {maximumFractionDigits: 0});
        document.getElementById('kpi-critical').textContent = data.by_level.critical || 0;

        document.getElementById('last-update').textContent = 'Last update: ' + new Date().toLocaleTimeString();

        const labels = data.scores.map(s => new Date(s.created_at).toLocaleDateString());
        const scores = data.scores.map(s => s.risk_score || 0);
        if (scoresChart) scoresChart.destroy();
        scoresChart = new Chart(document.getElementById('scoresChart'), {
          type: 'line',
          data: {
            labels,
            datasets: [{
              label: 'Risk Score',
              data: scores,
              borderColor: '#00d4ff',
              backgroundColor: 'rgba(0, 212, 255, 0.1)',
              borderWidth: 2,
              tension: 0.3,
              fill: true,
              pointBackgroundColor: '#e30613',
              pointRadius: 4,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, max: 100, ticks: { color: '#8892b0' }, grid: { color: '#1e2a52' } },
              x: { ticks: { color: '#8892b0' }, grid: { color: '#1e2a52' } }
            }
          }
        });

        const levels = ['low', 'medium', 'high', 'critical'];
        const levelCounts = levels.map(l => data.by_level[l] || 0);
        if (levelsChart) levelsChart.destroy();
        levelsChart = new Chart(document.getElementById('levelsChart'), {
          type: 'doughnut',
          data: {
            labels: ['Low', 'Medium', 'High', 'Critical'],
            datasets: [{
              data: levelCounts,
              backgroundColor: ['#22c55e', '#f59e0b', '#f97316', '#ef4444'],
              borderWidth: 0,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'bottom', labels: { color: '#c9d1e8', font: { size: 12 } } }
            }
          }
        });

        const supBody = document.getElementById('suppliers-body');
        if (data.top_suppliers.length === 0) {
          supBody.innerHTML = '<tr><td colspan="3" style="text-align:center;color:#8892b0;">No data yet</td></tr>';
        } else {
          supBody.innerHTML = data.top_suppliers.map(s => `
            <tr>
              <td>${s.supplier_name}</td>
              <td>${s.n}</td>
              <td>${(s.total || 0).toLocaleString('en-US', {maximumFractionDigits: 2})}</td>
            </tr>
          `).join('');
        }

        const recentBody = document.getElementById('recent-body');
        if (data.recent.length === 0) {
          recentBody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:#8892b0;">No analyses yet</td></tr>';
        } else {
          recentBody.innerHTML = data.recent.map(r => {
            const level = (r.risk_level || 'unknown').toLowerCase();
            const date = r.created_at ? new Date(r.created_at).toLocaleString() : '--';
            const amount = r.amount ? `${r.amount.toLocaleString()} ${r.currency || ''}` : '--';
            return `
              <tr>
                <td>${date}</td>
                <td>${r.document_reference || '--'}</td>
                <td>${r.supplier_name || '--'}</td>
                <td>${amount}</td>
                <td><span class="badge ${level}">${level} (${r.risk_score || 0})</span></td>
                <td>${r.decision || '--'}</td>
                <td><button class="trash-btn" data-id="${r.id}" title="Delete this analysis">&#128465;</button></td>
              </tr>
            `;
          }).join('');
        }
      } catch (e) {
        console.error('Failed to load stats:', e);
      }
    }

    // Delete a single analysis
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('.trash-btn');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      if (!id) return;
      if (!confirm('Delete this analysis permanently?')) return;
      try {
        const res = await fetch('/api/analysis/' + id, { method: 'DELETE' });
        if (res.ok) {
          loadStats();
        } else {
          alert('Failed to delete analysis');
        }
      } catch (err) {
        alert('Error: ' + err.message);
      }
    });

    loadStats();
    setInterval(loadStats, 10000);
  </script>
</body>
</html>