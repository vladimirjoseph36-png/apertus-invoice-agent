# === LLM Mode ===
# Set to "true" to use local Apertus 8B via Ollama (100% sovereign, offline)
# Set to "false" to use Groq cloud (fast, requires internet)
USE_LOCAL_APERTUS=false

# === Groq (cloud mode) ===
# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
APERTUS_MODEL=openai/gpt-oss-120b

# === Ollama (local mode - sovereign) ===
# Prerequisites: ollama pull MichelRosselli/apertus:8b-instruct-2509-q4_k_m
OLLAMA_MODEL=MichelRosselli/apertus:8b-instruct-2509-q4_k_m
OLLAMA_HOST=http://localhost:11434